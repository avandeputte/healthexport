# Copy to .env and fill in. .env is git-ignored; never commit it.
DB_HOST=mariadb.example.lan
DB_PORT=3306
DB_USER=health
DB_PASSWORD=
# Created on first start if the user is allowed to; otherwise it must already exist.
DB_NAME=health

# The phone sends this as "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
SYNC_TOKEN=

# Optional: serve HTTPS directly instead of behind a reverse proxy (mount the files into the container).
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
